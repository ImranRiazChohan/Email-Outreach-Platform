# Google Places API (New) key. Create one at https://console.cloud.google.com/
# and enable the "Places API (New)".
GOOGLE_MAPS_API_KEY=your_api_key_here

# SQLAlchemy database URL. Defaults to a local SQLite file.
# To migrate to PostgreSQL later, change this to something like:
# postgresql+psycopg2://user:password@localhost:5432/leads
DATABASE_URL=sqlite:///data/leads.db

# Maximum number of concurrent website requests during crawling.
MAX_CONCURRENT_CRAWLS=5

# Per-request timeout when fetching a homepage.
CRAWL_TIMEOUT_SECONDS=10

# Logging
LOG_LEVEL=INFO

# Gemini API key, used only to write the human-readable "reason" text behind
# each service recommendation (Website Analysis & Service Recommendation
# module). Get a key at https://aistudio.google.com/apikey
# If left blank, a canned rule-based reason template is used instead.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=4096

# Service opportunity score thresholds (0-100).
SERVICE_RECOMMEND_THRESHOLD=70
SERVICE_POTENTIAL_THRESHOLD=50

# Below this website_quality_score (0-100), a Website Redesign is considered.
WEBSITE_REDESIGN_QUALITY_THRESHOLD=60
